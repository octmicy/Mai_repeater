{
  "manifest_version": 2,
  "id": "maibot-community.mai-repeater",
  "name": "麦麦的本质就是复读机",
  "version": "1.4.0",
  "description": "群聊复读插件：群友复读文字/表情包/QQ原生表情时，插件识别并通过 SDK 直接发送复读内容，避免分词器自动断句导致复读失败。",
  "author": {
    "name": "octmicy",
    "url": "https://github.com/octmicy/Mai_repeater"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/octmicy/Mai_repeater",
    "homepage": "https://github.com/octmicy/Mai_repeater",
    "documentation": "https://docs.mai-mai.org"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "capabilities": [
    "send.text",
    "send.emoji",
    "send.custom",
    "config.get",
    "component.list_loaded_plugins"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.jpg",
      "fallback": "repeat"
    }
  }
}
